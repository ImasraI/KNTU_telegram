{
  "name": "kntu-personal-vc",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["9,39 * * * *"] },
  "d1_databases": [{ "binding": "PERSONAL_DB", "database_name": "kntu-personal-vc", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID" }],
  "observability": { "enabled": false }
}
