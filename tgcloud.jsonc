{
  // To host a Mini App, uncomment and set "source" to its build output folder:
  // "static": {
  //   "source": "dist"
  // },
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  "static": { "source": "setup", "headers": [{ "path": "/*", "set": { "Referrer-Policy": "no-referrer", "Cache-Control": "no-store" } }] }
}
